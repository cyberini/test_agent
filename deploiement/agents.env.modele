# ═════════════════════════════════════════════════════════════════════
#  Configuration de PRODUCTION des agents IA
#  Emplacement sur le VPS : /etc/agents-ia/agents.env  (droits 640, root:agents)
#  Ce fichier contient des secrets : il ne doit JAMAIS être versionné.
# ═════════════════════════════════════════════════════════════════════

# ── 1. Choix du modèle ───────────────────────────────────────────────
# Une seule ligne à changer pour changer de fournisseur (voir MODELES_ET_RGPD.md).
# En production pour des utilisateurs dans l'UE : JAMAIS de niveau gratuit.

# Option A : Gemini API, niveau PAYANT (projet avec facturation active)
MODELE_IA=gemini-flash-latest
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Option B : Gemini via Vertex AI, traitement dans une région européenne
# MODELE_IA=gemini-flash-latest
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=mon-projet-gcp
# GOOGLE_CLOUD_LOCATION=europe-west1
# GOOGLE_APPLICATION_CREDENTIALS=/etc/agents-ia/compte-service-gcp.json

# Option C : Mistral AI (société française)
# MODELE_IA=mistral/mistral-medium-latest
# MISTRAL_API_KEY=

# Option D : Claude (API Anthropic, PAS l'abonnement Pro/Max)
# MODELE_IA=anthropic/claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# Option E : OpenAI (projet API créé avec la région Europe)
# MODELE_IA=openai/NOM-DU-MODELE
# OPENAI_API_KEY=

# Option F : modèle open source sur VOTRE serveur GPU (vLLM), données 100 % maîtrisées
# MODELE_IA=hosted_vllm/Qwen/Qwen3-32B
# HOSTED_VLLM_API_BASE=http://10.0.0.5:8000/v1

# Option G : modèle local avec Ollama sur le même VPS ou un serveur voisin
# MODELE_IA=ollama_chat/qwen3:8b
# OLLAMA_API_BASE=http://127.0.0.1:11434

# ── 2. Garde-fous de coût et de fonctionnement ──────────────────────
# Nombre maximal d'appels au modèle par requête (évite les boucles coûteuses)
MAX_APPELS_LLM=25

# ── 3. Conservation des données (RGPD : minimisation) ──────────────
# Les conversations plus anciennes que ce nombre de jours sont supprimées chaque nuit
RETENTION_JOURS=30
# Durée de conservation des sauvegardes locales
SAUVEGARDE_JOURS=14

# ── 4. Accès à l'API ─────────────────────────────────────────────────
# Jeton exigé par Caddy (en-tête "Authorization: Bearer <jeton>").
# Généré automatiquement par installer.sh. Pour le changer : openssl rand -hex 32
AGENTS_API_TOKEN=

# ── 5. Pont Telegram (optionnel) ─────────────────────────────────────
# Jeton du bot fourni par @BotFather
TELEGRAM_BOT_TOKEN=
# Identifiants Telegram numériques autorisés, séparés par des virgules (liste blanche)
TELEGRAM_UTILISATEURS_AUTORISES=
# Agent (nom du dossier) qui répond sur Telegram
TELEGRAM_AGENT=mon_agent

# ── 6. Divers ────────────────────────────────────────────────────────
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
